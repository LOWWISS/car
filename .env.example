# Copy this file to .env and fill in real values. NEVER commit .env.
APP_NAME="Car Auction System"
APP_ENV=development
APP_URL=http://localhost/car
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=car_auction
DB_USER=root
DB_PASS=

# Mail (SMTP). If SMTP_HOST is empty, mail() fallback is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@carauction.local
SMTP_FROM_NAME="Car Auction System"

# Security
# 32-byte key, base64-encoded. Generate with: php -r "echo base64_encode(random_bytes(32));"
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
SESSION_LIFETIME=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=60
BID_RATE_LIMIT=10
